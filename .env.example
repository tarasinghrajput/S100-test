# AI generation
GEMINI_API_KEY=replace-with-your-gemini-key
GEMINI_MODEL=gemini-1.5-flash

# Email transport
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=replace-with-your-smtp-secret
SMTP_SECURE=false
MAIL_FROM="Portfolio Builder <no-reply@s100.apnapc.com>"

# General
APP_BASE_URL=https://s100.apnapc.com
PORT=4000
NODE_ENV=development
TRUST_PROXY=1
CORS_ORIGINS=https://s100.apnapc.com

# Frontend client
VITE_API_BASE_URL=https://s100.apnapc.com/api
VITE_API_CREDENTIALS=same-origin

# Database (optional but recommended)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=portfolio_builder
